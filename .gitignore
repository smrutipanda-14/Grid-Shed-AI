# ==========================================
# Grid-Shed AI — Master .gitignore
# Python (FastAPI + Celery + ML) & React (Vite)
# ==========================================

# --- Node / Frontend Build & Dependencies ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python Virtual Environments & Packages ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# --- Byte-compiled / Cache Files ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Celery & Redis Runtime Artifacts ---
celerybeat-schedule*
celerybeat.pid
dump.rdb

# --- Databases & Local Storage ---
*.db
*.sqlite
*.sqlite3
grid_shed.db

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Model Artifacts (Keep Pre-Trained model.joblib) ---
*.joblib
!backend/app/ml/model.joblib
